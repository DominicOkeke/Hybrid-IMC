  "reference_class_definitions": {
    "research_test_chip": "Single macro or small test die, comparable scale to this work's simulated tiles -- direct TOPS/W comparison is methodologically valid.",
    "commercial_product": "Full shipped chip/system with many replicated macros -- NOT directly comparable to a single tile without an explicit tile-scaling estimate (see per-config discussion above)."
  },
  "modeling_notes": [
    "NeuroSim assumes ideal devices without fabrication variability",
    "Wire parasitic analytically estimated, not layout-extracted",
    "System-level includes DRAM+buffer (most research test-chip refs are macro-level)",
    "ADC/DAC from published FoM, not chip-specific measurements",
    "Commercial-class comparisons use an explicit, caveated tile-scaling estimate, not a bare ratio",
    "Node-normalized (@7nm) values now included for references with a verified IRDS factor (22nm, 28nm); 14nm/40nm/4nm explicitly left unnormalized rather than guessed"
  ]
}